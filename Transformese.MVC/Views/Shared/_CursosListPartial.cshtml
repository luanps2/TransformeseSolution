@model IEnumerable<CursoDto>

<div class="row g-4">
    @foreach (var curso in Model)
    {
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <img src="@(string.IsNullOrEmpty(curso.Imagem) ? "/images/default-course.jpg" : curso.Imagem)"
                     class="card-img-top" alt="@curso.Nome" />
                <div class="card-body">
                    <h5 class="card-title">@curso.Nome</h5>
                    <p class="card-text text-muted">@curso.Descricao</p>
                    <button class="btn btn-primary" onclick="abrirModalDetalhes(@curso.IdCurso)">Ver mais</button>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalDetalhesCurso" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalhes do Curso</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="cursoDetalhesContainer">Carregando...</div>
            </div>
        </div>
    </div>
</div>
