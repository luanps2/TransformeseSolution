@model IEnumerable<UsuarioDto>
@using System.Linq
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Administradores";
    var apiBase = (Configuration["Api:BaseUrl"] ?? "").TrimEnd('/');
    string FotoUrl(string img)
    {
        if (string.IsNullOrWhiteSpace(img)) return "/images/default-user.jpg";
        if (img.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return img;
        return string.IsNullOrEmpty(apiBase) ? $"/images/usuarios/{img}" : $"{apiBase}/images/usuarios/{img}";
    }
}

<h2 class="mb-4">Administradores</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Novo Administrador</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th style="width:80px;">Foto</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Data Nasc.</th>
            <th class="text-end" style="width:180px;">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var admin in Model ?? Enumerable.Empty<UsuarioDto>())
        {
            <tr>
                <td>
                    <img src="@FotoUrl(admin.Imagem)" alt="Foto" class="rounded-circle" style="width:64px;height:64px;object-fit:cover;" />
                </td>
                <td class="align-middle">@admin.Nome</td>
                <td class="align-middle">@admin.Email</td>
                <td class="align-middle">@(admin.DataNascimento.ToString("yyyy-MM-dd"))</td>
                <td class="align-middle text-end">
                    <div class="btn-group" role="group" aria-label="Ações">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@admin.IdUsuario" title="Ver">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@admin.IdUsuario" title="Editar">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@admin.IdUsuario" method="post" class="d-inline-block ms-1" onsubmit="return confirm('Confirma exclusão deste administrador?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Deletar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
