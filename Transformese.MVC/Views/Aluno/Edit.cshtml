@model UsuarioDto
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Editar Aluno";
    var apiBase = (Configuration["Api:BaseUrl"] ?? "").TrimEnd('/');
    string FotoUrl(string img)
    {
        if (string.IsNullOrWhiteSpace(img)) return "/images/default-user.jpg";
        if (img.StartsWith("http", System.StringComparison.OrdinalIgnoreCase)) return img;
        return string.IsNullOrEmpty(apiBase) ? $"/images/usuarios/{img}" : $"{apiBase}/images/usuarios/{img}";
    }
}

<h2>Editar Aluno</h2>

<form asp-action="Edit" asp-route-id="@Model.IdUsuario" method="post" enctype="multipart/form-data" class="row g-3">
    @Html.AntiForgeryToken()

    <div class="col-md-6">
        <label class="form-label">Nome</label>
        <input name="Nome" value="@Model.Nome" class="form-control" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Email</label>
        <input name="Email" value="@Model.Email" class="form-control" type="email" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Senha (preencha para alterar)</label>
        <input name="Senha" class="form-control" type="password" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Data de Nascimento</label>
        <input name="DataNascimento" value="@Model.DataNascimento.ToString("yyyy-MM-dd")" class="form-control" type="date" />
    </div>

    <div class="col-md-4">
        <label for="FotoPerfil" class="form-label">Foto de Perfil</label>
        <input type="file" name="FotoPerfil" class="form-control" accept="image/*" />
        @if (!string.IsNullOrEmpty(Model.Imagem))
        {
            <img src="@FotoUrl(Model.Imagem)" class="mt-2 rounded" style="width:96px;height:96px;object-fit:cover;" />
        }
    </div>

    <input type="hidden" name="TipoUsuarioId" value="3" />

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}